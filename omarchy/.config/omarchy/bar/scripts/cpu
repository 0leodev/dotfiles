#!/bin/bash
# CPU usage and temperature monitor for Omarchy bar

# Get CPU usage
get_cpu_usage() {
    local values
    values=$(grep '^cpu ' /proc/stat | sed 's/^cpu[[:space:]]*//' | tr -s ' ')
    
    local user nice system idle iowait irq softirq steal guest guest_nice
    read -r user nice system idle iowait irq softirq steal guest guest_nice <<< "$values"
    
    local total=$((user + nice + system + idle + iowait + irq + softirq + steal + guest + guest_nice))
    local idle_combined=$((idle + iowait + guest))
    
    echo "$total $idle_combined"
}

# Get CPU temperature
get_temp() {
    local temp_line
    temp_line=$(sensors 2>/dev/null | grep 'Tctl:' | head -1)
    
    if [ -n "$temp_line" ]; then
        echo "$temp_line" | awk '{print $2}' | tr -d '+°C'
    else
        echo "N/A"
    fi
}

# Calculate CPU usage
read -r total1 idle1 <<< "$(get_cpu_usage)"
sleep 0.5
read -r total2 idle2 <<< "$(get_cpu_usage)"

total_diff=$((total2 - total1))
idle_diff=$((idle2 - idle1))

if [ "$total_diff" -gt 0 ]; then
    usage=$(( (total_diff - idle_diff) * 100 / total_diff ))
else
    usage=0
fi

# Get temperature
temp=$(get_temp)

# Build output
if [ "$temp" = "N/A" ]; then
    echo "{\"text\":\"󰍛 ${usage}% · N/A\",\"tooltip\":\"CPU Usage: ${usage}%\\nTemperature: N/A\"}"
else
    temp_int=$(echo "$temp" | cut -d. -f1)
    if [ "$temp_int" -ge 80 ]; then
        class="critical"
    elif [ "$temp_int" -ge 60 ]; then
        class="warning"
    else
        class="normal"
    fi
    echo "{\"text\":\"󰍛 ${usage}% · ${temp}°C\",\"tooltip\":\"CPU Usage: ${usage}%\\nTemperature: ${temp}°C\",\"class\":\"${class}\"}"
fi